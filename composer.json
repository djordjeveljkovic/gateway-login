{
    "name": "djordjeveljkovic/gateway-login",
    "description": "Puts a Laravel app behind the New Login gateway: only approved computers get in. composer require, add four .env lines, done.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/djordjeveljkovic/gateway-login",
    "keywords": ["laravel", "login", "gateway", "client-certificate", "zero-trust"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/cache": "^12.0",
        "paragonie/sodium_compat": "^2.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "GatewayLogin\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "GatewayLogin\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["GatewayLogin\\GatewayServiceProvider"],
            "aliases": { "Gateway": "GatewayLogin\\Gateway" }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
